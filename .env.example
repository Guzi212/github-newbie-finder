# --- LLM provider ---------------------------------------------------------
# One of: echo | deepseek | anthropic | openai
# "echo"     deterministic stub. Lets the whole pipeline run with no keys.
# "deepseek" recommended real provider (cheap, OpenAI-compatible).
# "anthropic" / "openai" also supported via the same interface.
LLM_PROVIDER=echo

# Model name. Defaults pick a sensible model per provider, override if needed.
#   deepseek  → deepseek-chat
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o-mini
LLM_MODEL=

# Keys (only the provider you select needs one)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# DeepSeek's OpenAI-compatible base URL. Override only if self-hosting.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- GitHub ---------------------------------------------------------------
# A personal access token raises the search limit from 10 → 30 req/min.
# Even a "no scope" token works for public repo search + read.
GITHUB_TOKEN=

# --- Storage --------------------------------------------------------------
DATABASE_URL=sqlite:///./data/finder.db

# --- Networking -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
